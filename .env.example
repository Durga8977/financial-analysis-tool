# Flask Configuration
FLASK_ENV=development
FLASK_APP=app.py
SECRET_KEY=your_secret_key_here

# Database Configuration
DATABASE_URL=sqlite:///financial_analysis.db
# For PostgreSQL: postgresql://user:password@localhost:5432/financial_analysis

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000

# Price Alert Settings
ALERT_CHECK_INTERVAL=300  # seconds (5 minutes)

# Data Sources
YFINANCE_TIMEOUT=10
