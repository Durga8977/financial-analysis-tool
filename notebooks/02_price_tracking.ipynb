 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Price Tracking Notebook\n",
    "\n",
    "This notebook demonstrates:\n",
    "- Real-time price fetching\n",
    "- Historical price analysis\n",
    "- Price comparisons\n",
    "- Price trend visualization"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import plotly.graph_objects as go\n",
    "import plotly.express as px\n",
    "import requests\n",
    "from datetime import datetime\n",
    "\n",
    "API_BASE_URL = 'http://localhost:5000/api'"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Get Current Prices"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Get current price for a stock\n",
    "response = requests.get(f'{API_BASE_URL}/prices/current/AAPL?asset_type=stock')\n",
    "price_data = response.json()\n",
    "\n",
    "print(f\"AAPL Current Price: ${price_data['price']:.2f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Get current price for crypto\n",
    "response = requests.get(f'{API_BASE_URL}/prices/current/BTC-USD?asset_type=crypto')\n",
    "crypto_data = response.json()\n",
    "\n",
    "print(f\"Bitcoin Current Price: ${crypto_data['price']:.2f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Compare Multiple Prices"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Compare multiple symbols\n",
    "symbols = ['AAPL', 'MSFT', 'GOOGL', 'TSLA']\n",
    "asset_types = {s: 'stock' for s in symbols}\n",
    "\n",
    "response = requests.post(f'{API_BASE_URL}/prices/compare', \n",
    "                         json={'symbols': symbols, 'asset_types': asset_types})\n",
    "prices = response.json()['symbols']\n",
    "\n",
    "for symbol, data in prices.items():\n",
    "    print(f\"{symbol}: ${data['price']:.2f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Historical Price Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Get 30-day price history\n",
    "response = requests.get(f'{API_BASE_URL}/prices/historical/AAPL?days=30&asset_type=stock')\n",
    "price_history = response.json()['prices']\n",
    "\n",
    "df = pd.DataFrame(price_history)\n",
    "df['Date'] = pd.to_datetime(df['Date'])\n",
    "\n",
    "print(f\"Price history for last 30 days ({len(df)} records):\")\n",
    "print(df.head())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Visualize price trend\n",
    "fig = px.line(df, x='Date', y='Close', \n",
    "              title='AAPL Price - Last 30 Days',\n",
    "              labels={'Close': 'Price ($)'})\n",
    "fig.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Price Change Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Get price change for different periods\n",
    "periods = ['1d', '1wk', '1mo', '3mo']\n",
    "\n",
    "for period in periods:\n",
    "    response = requests.get(f'{API_BASE_URL}/prices/change/AAPL?period={period}&asset_type=stock')\n",
    "    change_data = response.json()\n",
    "    print(f\"\\n{period}:\")\n",
    "    print(f\"  Current Price: ${change_data['current']:.2f}\")\n",
    "    print(f\"  Change: ${change_data['change']:.2f} ({change_data['change_percent']:.2f}%)\")")
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Stock Information"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Get detailed stock info\n",
    "response = requests.get(f'{API_BASE_URL}/stock/info/AAPL')\n",
    "info = response.json()\n",
    "\n",
    "print(f\"Company: {info.get('name')}\")\n",
    "print(f\"Sector: {info.get('sector')}\")\n",
    "print(f\"Industry: {info.get('industry')}\")\n",
    "print(f\"Market Cap: ${info.get('market_cap', 'N/A'):,}\")\n",
    "print(f\"P/E Ratio: {info.get('pe_ratio')}\")\n",
    "print(f\"52-Week High: ${info.get('52week_high')}\")\n",
    "print(f\"52-Week Low: ${info.get('52week_low')}\")"
   ]
  }
 ],
